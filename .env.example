# Copy this file to `.env` and fill in your Supabase project values.
# `.env` is gitignored — never commit real keys.
#
# Find these in your Supabase dashboard → Project Settings → API:
#   - Project URL          -> VITE_SUPABASE_URL
#   - Project API keys → anon / public  -> VITE_SUPABASE_ANON_KEY
#
# The anon key is SAFE to expose in the client (it is protected by Row Level
# Security). Do NOT put the service_role key here or anywhere in the app.
#
# On Vercel, set these same two variables under
#   Project → Settings → Environment Variables
# (they must be prefixed with VITE_ to be exposed to the browser bundle).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
