# Copy to .env (never commit it). Each book can have its own Alpaca paper account.
ANTHROPIC_API_KEY=
# Optional model override (default in config/playbook.yaml)
CLAUDE_MODEL=

# Market data (any Alpaca paper key works for data)
ALPACA_DATA_KEY=
ALPACA_DATA_SECRET=

# Book "rules": rules decide, Claude may only veto or shrink
ALPACA_RULES_KEY=
ALPACA_RULES_SECRET=

# Book "claude": Claude decides inside the hard risk limits
ALPACA_CLAUDE_KEY=
ALPACA_CLAUDE_SECRET=
