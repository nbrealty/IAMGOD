# Copy to .env (never commit it). Environment variables that are already set win over this file.

# Book "rules": its Alpaca paper account. The rules decide; Claude may only skip or halve new entries.
ALPACA_RULES_KEY=
ALPACA_RULES_SECRET=

# Book "claude": its own Alpaca paper account, once it exists. Until then leave these empty and run the
# Claude book on the local simulator (--sim claude), as SESSION_RUNBOOK.md does.
ALPACA_CLAUDE_KEY=
ALPACA_CLAUDE_SECRET=

# Market data (optional). Empty = use the rules account's keys, which is the normal setup.
ALPACA_DATA_KEY=
ALPACA_DATA_SECRET=

# The state folder is chosen with the TRADER_STATE_DIR environment variable (default trading/state).
# It is read before this file, so set it in the shell, not here.

# Only for the alternative API path (claude.mode: api in config/playbook.yaml). Option B needs no API key.
ANTHROPIC_API_KEY=
# Optional model override for the API path (default in config/playbook.yaml)
CLAUDE_MODEL=
